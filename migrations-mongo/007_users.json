{
  "collections": {
    "auth_users": {
      "indexes": [
        {
          "name": "channel_identity_unique",
          "keys": [
            [
              "channels.channel",
              1
            ],
            [
              "channels.sender_id",
              1
            ]
          ],
          "unique": true,
          "partialFilterExpression": {
            "channels.channel": {
              "$exists": true
            }
          }
        },
        {
          "name": "binding_id_unique",
          "keys": [
            [
              "channels.binding_id",
              1
            ]
          ],
          "unique": true,
          "partialFilterExpression": {
            "channels.binding_id": {
              "$exists": true
            }
          }
        },
        {
          "name": "email_unique",
          "keys": [
            [
              "email",
              1
            ]
          ],
          "unique": true,
          "sparse": true
        }
      ]
    }
  }
}
